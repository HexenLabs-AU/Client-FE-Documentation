{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fleet Empire",
  "colors": {
    "primary": "#2563EB",
    "light": "#93C5FD",
    "dark": "#1D4ED8"
  },
  "favicon": {
    "light": "/images/branding/robloxLogo.webp",
    "dark": "/images/branding/robloxLogo.webp"
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  },
  "logo": {
    "light": "/images/branding/robloxLogoWithDarkText.png",
    "dark": "/images/branding/robloxLogoWithLightText.png"
  },
  "navbar": {
    "links": [
      {
        "href": "https://www.roblox.com/games/128776499486135/Fleet-Empire",
        "label": "Roblox",
        "icon": "/images/externalBranding/roblox.svg"
      }
    ],
    "primary": {
      "type": "discord",
      "href": "https://discord.gg/xtvqCYBDYp"
    }
  },
  "contextual": {
    "options": [
      "copy"
    ],
    "display": "header"
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "light": "#F7F8FA",
      "dark": "#111113"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system",
    "latex": true
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": true
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "404 — Looks like we took a wrong turn",
      "description": "This page fell off the truck. Let’s head back home."
    }
  },
  "thumbnails": {
    "background": "/images/branding/social-background.png"
  },
  "fonts": {
    "family": "Inter"
  },
  "description": "Beginner-friendly Fleet Empire guides for building your fleet, hiring staff, finding freight, and managing your trucking company.",
  "search": {
    "prompt": "Search guides..."
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/docs",
      "permanent": false
    }
  ],
  "footer": {
    "links": [
      {
        "header": "Fleet Empire",
        "items": [
          {
            "label": "Roblox",
            "href": "https://www.roblox.com/games/128776499486135/Fleet-Empire"
          },
          {
            "label": "Discord",
            "href": "https://discord.gg/xtvqCYBDYp"
          }
        ]
      },
      {
        "header": "Reward codes",
        "items": [
          {
            "label": "RELEASE",
            "href": "/docs/gettingstarted/codes"
          },
          {
            "label": "ALPHA",
            "href": "/docs/gettingstarted/codes"
          },
          {
            "label": "ROADTRIP",
            "href": "/docs/gettingstarted/codes"
          }
        ]
      },
      {
        "header": "Latest update",
        "items": [
          {
            "label": "October 11, 2026",
            "href": "/docs/developer/update-log"
          }
        ]
      }
    ]
  }
}
